{
  "name": "trustline-spring-cleaning-tool-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --config ../prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ../prisma.config.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "@stellar/stellar-sdk": "16.1.0",
    "cors": "^2.8.5",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
