{
  "name": "trustline-spring-cleaning-tool",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm run db:generate && npm --workspace frontend run build && npm --workspace backend run build",
    "db:generate": "npm --workspace backend run db:generate",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:seed": "npm --workspace backend run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "dotenv": "^17.2.3"
  }
}
